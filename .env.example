# ==============================================================================
# AI Support Platform - environment variables
# Copy to .env at the root, and to backend/.env + ai-service/.env for local
# (non-Docker) service runs. Never commit real .env files - .gitignore covers
# them. No secrets are hard-coded anywhere in the codebase (Operating Rule 4).
# ==============================================================================

# --- Postgres (used by docker-compose to init the container) ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_support_platform

# --- Backend (Node/Express) --------------------------------------------------
NODE_ENV=development
PORT=4000

# Local connection. On Neon use the pooled "-pooler" URL for the running app
# and the direct (non-pooled) URL for migrations. Both need sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_support_platform
DATABASE_URL_UNPOOLED=

# Comma-separated browser origins. Use the deployed Vercel URL in production.
CORS_ORIGIN=http://localhost:5173

# JWT - generate real random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Use rediss:// for a TLS Redis/Valkey endpoint.
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000

# --- AI service (Python/FastAPI) --------------------------------------------
ENV=development
PORT=8000
BACKEND_URL=http://localhost:4000

# JSON list. In production include the deployed Vercel origin.
CORS_ORIGINS=["http://localhost:5173","http://localhost:4000"]

# Chat provider: openai | deepseek | openai-compatible
LLM_PROVIDER=openai

# OpenAI is also required for embeddings (text-embedding-3-small, 1536 dims)
# even when chat uses DeepSeek or another OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# DeepSeek direct API (LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Generic OpenAI-compatible endpoint (LLM_PROVIDER=openai-compatible).
# NVIDIA Build example, checked 2026-10-28:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
#   LLM_API_KEY=<NVIDIA Build API key>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Frontend (Vite) ----------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

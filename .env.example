# ==============================================================================
# AI Support Platform — environment variables
# Copy to .env at the root, and to backend/.env + ai-service/.env for local
# (non-Docker) service runs. Never commit real .env files — .gitignore covers
# them. No secrets are hard-coded anywhere in the codebase (Operating Rule 4).
# ==============================================================================

# --- Postgres (used by docker-compose to init the container) ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_support_platform

# --- Backend (Node/Express) --------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_support_platform
CORS_ORIGIN=http://localhost:5173

# JWT — generate real random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000

# --- AI service (Python/FastAPI) --------------------------------------------
ENV=development
AI_SERVICE_PORT=8000
BACKEND_URL=http://localhost:4000

# LLM provider — "openai" or "deepseek"
LLM_PROVIDER=openai

# OpenAI key — required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# DeepSeek key — required when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Frontend (Vite) ----------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
